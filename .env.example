# =========================================
# Mind Link — Environment Variables
# =========================================
# Copy this file to .env for local development.
# On Render, set secret values in the Environment tab of the dashboard.
# The render.yaml file defines keys — you provide the values in the dashboard.

# ─── Flask ───────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-string

# 'development' | 'production'
FLASK_ENV=development

# Set to '1' to enable Flask debug mode (local dev only — never in production)
FLASK_DEBUG=0

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used in admin console output and email links.
# Example: https://mindlinkpsychiatry.com
SITE_URL=http://localhost:5000

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Get this from: Supabase → your project → Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Email / SMTP Settings ────────────────────────────────────────────────────
# Used to send appointment notifications to patients.
# Gmail recommended — create an App Password at:
# https://myaccount.google.com/apppasswords  (requires 2-Step Verification)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-clinic-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_NAME=Mind Link Psychiatry Clinic
FROM_EMAIL=your-clinic-email@gmail.com

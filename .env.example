# =========================================
# Mind Link — Environment Variables
# =========================================
# Copy this file to .env for local development.
#   cp .env.example .env
#
# For production VPS: set all values in /etc/mindlink/mindlink.env
# The .env file is listed in .gitignore and must NEVER be committed.
# =========================================

# ─── Flask ───────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-string

# 'development' | 'production'
FLASK_ENV=development

# Set to '1' to enable Flask debug mode (local dev only — NEVER in production)
FLASK_DEBUG=0

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used in admin console output (first-boot message).
# Example: https://yourdomain.com
SITE_URL=http://localhost:5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection URI.
#
# For LOCAL DEVELOPMENT (Supabase):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
#   DATABASE_SSL_MODE=require
#
# For PRODUCTION VPS (local PostgreSQL 16):
#   DATABASE_URL=postgresql://mindlink_user:[YOUR-PASSWORD]@127.0.0.1:5432/mindlink_db
#   DATABASE_SSL_MODE=disable
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# SSL mode for database connection:
#   'require'  — always use SSL (use for Supabase / cloud databases)
#   'disable'  — no SSL (use for local PostgreSQL on the same machine)
#   'prefer'   — attempt SSL, fall back gracefully (safe default)
# If DATABASE_URL already contains 'sslmode=', this variable is ignored.
DATABASE_SSL_MODE=require

# ─── Email / Resend ───────────────────────────────────────────────────────────
# Used to send transactional emails (appointment confirmations, cancellations,
# and new-appointment notifications to the doctor).
#
# Sign up at https://resend.com and create an API key.
# For PRE-PRODUCTION testing, use the Resend test sender:
#   FROM_EMAIL=onboarding@resend.dev
# For PRODUCTION, verify your own domain and use:
#   FROM_EMAIL=appointments@yourdomain.com
#
# RESEND_API_KEY  — Your Resend API key (starts with 're_')
# FROM_EMAIL      — Sender address (use onboarding@resend.dev for pre-production)
# DOCTOR_EMAIL    — Doctor/admin email that receives new-appointment notifications

RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
DOCTOR_EMAIL=

# ─── Admin Default Credentials (first boot only) ──────────────────────────────
# These are used ONLY on first boot if no admin user exists in the database.
# Change the admin password immediately after the first login.
# After changing, these variables have no effect.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me-immediately

# =========================================
# Mind Link — Git Ignore
# =========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables (contains real secrets — never commit)
.env

# SQLite database (created at runtime — use Render Disk for persistence)
*.db

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Dev utilities (not needed in production)
check_db.py

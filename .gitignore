# =========================================
# Mind Link — Git Ignore
# =========================================

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
*.pyo
*.pyd

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/

# ─── Environment variables (NEVER commit secrets) ─────────────────────────────
.env
.env.local
.env.*.local
# Also exclude any accidentally-created real env files under deploy/
deploy/*.env
deploy/mindlink.env

# ─── Flask instance folder ────────────────────────────────────────────────────
instance/

# ─── SQLite database (development remnant) ────────────────────────────────────
*.db

# ─── Testing & Coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
